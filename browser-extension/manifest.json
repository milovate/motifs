{
  "manifest_version": 3,
  "name": "Capture Studio",
  "version": "0.2.0",
  "description": "Keeps a short, local buffer of console messages and failed requests, and records page steps while you record the screen. Nothing leaves your Mac unless you send a capture.",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": [
    "nativeMessaging",
    "webRequest",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "relay.js",
        "steps-core.js",
        "steps.js"
      ],
      "run_at": "document_start"
    }
  ]
}
